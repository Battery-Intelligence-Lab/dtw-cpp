*.sh text eol=lf
*.slurm text eol=lf
# slurm_remote.sh reads it with bash, which keeps a CR in the last field.
python/dtwcpp/_slurm/gpu_devices.txt text eol=lf

# Fixtures the tests read byte-for-byte, so any end-of-line translation on
# checkout changes what they parse. Git for Windows ships core.autocrlf=true in its system
# config -- which is what the GitHub windows-latest runner uses -- so without
# these rules the tracked LF blobs arrive as CRLF there and nowhere else.
tests/conformance/** text eol=lf
*.csv text eol=lf
# The CRLF twin of tests/data/reader/trailing_blank.csv: its CRs are what it tests.
tests/data/reader/trailing_blank_crlf.csv -text
