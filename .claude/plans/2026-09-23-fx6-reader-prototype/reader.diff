+
+/// The one line loop for every text reader: skips `start_row` header lines,
+/// stops after `Ndata` data lines (-1 = all) and calls `on_line(line, row)`
+/// with a 1-based row. Blank lines after the last data line are ignored; a
+/// blank line followed by data is an error. It used to become an empty series
+/// (batch file) or vanish and shift the series (folder file), silently.
+template <typename OnLine>
+std::size_t for_each_data_line(std::istream &in, const fs::path &path,
+                               int start_row, int Ndata, OnLine &&on_line)
+{
+  std::string line;
+  std::size_t row = 0, produced = 0, blank_row = 0;
+  while ((Ndata < 0 || produced < static_cast<std::size_t>(Ndata))
+         && std::getline(in, line)) {
+    if (++row <= static_cast<std::size_t>(start_row)) continue;
+    if (trim_ascii(line).empty()) {
+      if (blank_row == 0) blank_row = row;
+      continue;
+    }
+    if (blank_row != 0)
+      throw std::runtime_error(
+        "Error in delimited text file: '" + path.string() + "' row "
+        + std::to_string(blank_row) + " is empty; an empty line is neither a "
+          "series nor a value (write a missing value as nan).");
+    on_line(std::string_view(line), row);
+    ++produced;
+  }
+  return produced;
 }
 
