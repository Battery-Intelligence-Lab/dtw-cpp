# Only the keys that differ from the Doxygen 1.12 defaults (`doxygen -x`); CI runs
# mattnotmitt/doxygen-action v1.12 from the repository root. Every other key is the default.

PROJECT_NAME           = DTWC++
PROJECT_NUMBER         = 1.0.0
PROJECT_BRIEF          = "A faster time-series clustering library in C++"
PROJECT_LOGO           = ./docs/static/docs_logo.png
OUTPUT_DIRECTORY       = build/Doxygen
TOC_INCLUDE_HEADINGS   = 5
EXTRACT_ALL            = YES
INPUT                  = ./dtwc \
                         ./examples \
                         ./python \
                         ./bindings/matlab \
                         ./CHANGELOG.md \
                         ./README.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = ./README.md
HTML_HEADER            = ./docs/header.html
HTML_EXTRA_STYLESHEET  = ./docs/doxygen-awesome.css \
                         ./docs/doxygen-awesome-sidebar-only.css \
                         ./docs/custom.css
HTML_COLORSTYLE        = LIGHT
GENERATE_TREEVIEW      = YES
FORMULA_FONTSIZE       = 12
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
GENERATE_LATEX         = NO
HAVE_DOT               = YES
DOT_NUM_THREADS        = 2
UML_LOOK               = YES
DOT_IMAGE_FORMAT       = svg
