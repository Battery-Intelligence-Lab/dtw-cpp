# Only the keys that differ from the Doxygen 1.12 defaults (`doxygen -x`); CI runs
# mattnotmitt/doxygen-action v1.12 from the repository root. Every other key is the default.

PROJECT_NAME           = DTWC++
PROJECT_NUMBER         = 2.0.0
PROJECT_BRIEF          = "A faster time-series clustering library in C++"
PROJECT_LOGO           = ./docs/static/docs_logo.png
OUTPUT_DIRECTORY       = build/Doxygen
TOC_INCLUDE_HEADINGS   = 5
EXTRACT_ALL            = YES
INPUT                  = ./dtwc \
                         ./examples \
                         ./python \
                         ./bindings/matlab \
                         ./CHANGELOG.md \
                         ./README.md
RECURSIVE              = YES
EXCLUDE                = ./dtwc/extern
FILE_PATTERNS          = *.c \
                         *.cc \
                         *.cxx \
                         *.cpp \
                         *.c++ \
                         *.dox \
                         *.cu \
                         *.cuh \
                         *.h \
                         *.hh \
                         *.hxx \
                         *.hpp \
                         *.h++ \
                         *.m \
                         *.mm \
                         *.py \
                         *.md
EXTENSION_MAPPING      = cu=C++ \
                         cuh=C++
USE_MDFILE_AS_MAINPAGE = ./README.md
HTML_HEADER            = ./docs/header.html
HTML_EXTRA_STYLESHEET  = ./docs/doxygen-awesome.css \
                         ./docs/doxygen-awesome-sidebar-only.css \
                         ./docs/custom.css
HTML_COLORSTYLE        = LIGHT
GENERATE_TREEVIEW      = YES
FORMULA_FONTSIZE       = 12
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
GENERATE_LATEX         = NO
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = DTWC_HAS_CUDA \
                         DTWC_HAS_METAL \
                         DTWC_HAS_PARQUET \
                         DTWC_HAS_ARROW \
                         DTWC_ENABLE_HIGHS \
                         DTWC_ENABLE_GUROBI \
                         DTWC_HAS_MMAP \
                         DTWC_HAS_CPUINFO \
                         DTWC_ALWAYS_INLINE=inline \
                         DTWC_KERNEL_FORCE_INLINE=inline
HAVE_DOT               = YES
DOT_NUM_THREADS        = 2
UML_LOOK               = YES
DOT_IMAGE_FORMAT       = svg
